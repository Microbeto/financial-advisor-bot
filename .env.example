# Copy this file to .env before running Docker Compose.
# Security
APP_SECRET=change-this-in-production

# Optional admin bootstrap
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=Admin@12345

# Optional data/cache tunables
MARKET_CACHE_TTL_DAYS=7
NEWS_CACHE_TTL_DAYS=30

# Optional CORS override
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
